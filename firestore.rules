rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      // NB : on ne vérifie PAS email_verified — selon le provider, ce claim peut
      // être absent/false dans le token (ce qui bloquait la console admin). Le
      // claim `email` d'un token Firebase est signé par Firebase et ne peut pas
      // être falsifié par le client, donc le check email seul est sûr.
      return isAuth()
          && request.auth.token.email == 'david.mathys24@gmail.com';
    }

    // Accès à un carnet : propriétaire ou collaborateur (sharedWith).
    // Coûte une lecture supplémentaire par opération sur memories — acceptable.
    function canAccessNotebook(notebookId) {
      let nb = get(/databases/$(database)/documents/notebooks/$(notebookId)).data;
      return nb.userId == request.auth.uid
          || request.auth.uid in nb.get('sharedWith', []);
    }

    function ownsChild(childId) {
      return get(/databases/$(database)/documents/children/$(childId)).data.parentId
          == request.auth.uid;
    }

    // ── Notebooks ──────────────────────────────────────────────────────────
    //
    // La porte « invité par e-mail » (`invitedEmails`) a été RETIRÉE le
    // 01.10.26. Elle accordait la lecture à quiconque présente un jeton dont
    // le claim `email` figure dans la liste — or l'app ne demande aucune
    // vérification d'adresse : connaître une adresse invitée mais pas encore
    // inscrite suffisait à créer ce compte et à entrer. C'était un chemin
    // mort de toute façon : plus aucune ligne de code n'AJOUTE d'adresse à
    // `invitedEmails` depuis la bascule vers les tags, le partage réel passe
    // par un lien d'invitation (backend/api/tag/[action].ts).
    match /notebooks/{notebookId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid
        || request.auth.uid in resource.data.get('sharedWith', [])
      );

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAuth() && (
        // Propriétaire : tout
        resource.data.userId == request.auth.uid
        // Collaborateur : compteurs uniquement
        || (request.auth.uid in resource.data.get('sharedWith', [])
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['memoriesCount', 'lastMemoryAt', 'updatedAt']))
      );

      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ── Tags (organisation + partage) ───────────────────────────────────────
    // Le partage se pilote ici : les collaborateurs d'un tag sont recopiés dans
    // le champ `sharedWith` de chaque souvenir qui le porte (voir memories).
    match /tags/{tagId} {
      // Même retrait que sur les carnets (01.10.26) : plus de porte
      // `invitedEmails`, non vérifiée et plus alimentée par personne.
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid
        || request.auth.uid in resource.data.get('sharedWith', [])
      );

      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAuth() && resource.data.userId == request.auth.uid;

      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ── Memories ────────────────────────────────────────────────────────────
    // Trois portes d'entrée, dans l'ordre du moins cher au plus cher :
    //  1. `userId`     → le propriétaire ;
    //  2. `sharedWith` → un collaborateur, via un tag partagé (champ recopié) ;
    //  3. `notebookId` → repli pour les souvenirs d'avant les tags (une lecture
    //     supplémentaire ; disparaîtra quand tous les comptes seront migrés).
    match /memories/{memoryId} {
      function memberOfMemory(mem) {
        return mem.get('userId', '') == request.auth.uid
            || request.auth.uid in mem.get('sharedWith', [])
            || (mem.get('notebookId', '') != ''
                && canAccessNotebook(mem.notebookId));
      }

      function isMemoryOwner() {
        return resource.data.get('userId', '') == request.auth.uid;
      }

      allow read: if isAuth() && memberOfMemory(resource.data);
      allow create: if isAuth()
        && request.resource.data.get('userId', '') == request.auth.uid;
      // `userId` immuable après création : sans ça, un collaborateur invité
      // sur un tag (donc membre via `sharedWith`, pas propriétaire) pouvait
      // réécrire `userId` vers son propre uid ET vider `sharedWith` en un
      // seul update — volant le souvenir à son vrai propriétaire (trouvé lors
      // de l'audit sécurité du 03.09.26).
      //
      // Resserré le 01.10.26 : un collaborateur (membre via `sharedWith`,
      // pas propriétaire) peut modifier le CONTENU du souvenir — titre, date,
      // lieu, texte, médias, tags — mais pas sa STRUCTURE D'ACCÈS. Avant, il
      // pouvait réécrire `sharedWith` (donc retirer les autres invités) et
      // déplacer le souvenir vers un autre carnet. Le propriétaire, lui,
      // garde tous les droits. Côté app, `memory_create_screen.dart::_save`
      // renvoie les valeurs d'origine de ces champs quand l'éditeur n'est pas
      // le propriétaire.
      allow update: if isAuth()
        && memberOfMemory(resource.data)
        && memberOfMemory(request.resource.data)
        && request.resource.data.get('userId', '') == resource.data.get('userId', '')
        && (
          isMemoryOwner()
          || (request.resource.data.get('sharedWith', [])
                == resource.data.get('sharedWith', [])
              && request.resource.data.get('notebookId', '')
                == resource.data.get('notebookId', ''))
        );
      // Suppression réservée au PROPRIÉTAIRE (01.10.26). Avant, tout membre
      // pouvait supprimer : un grand-parent invité sur un tag effaçait
      // définitivement le souvenir du parent, médias R2 compris, d'un seul
      // geste et sans recours. Un invité qui ne veut plus voir un souvenir
      // n'a pas à le détruire pour tout le monde.
      allow delete: if isAuth() && isMemoryOwner();
    }

    // ── Books (histoires IA, legacy) ────────────────────────────────────────
    match /books/{bookId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    // ── Generated books (historique des PDF générés) ─────────────────────────
    match /generatedBooks/{bookId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    // ── Brouillons de livres (éditeur d'aperçu, sauvegarde auto) ────────────
    // Propriétaire uniquement ; un brouillon ne peut pas changer de main.
    match /bookDrafts/{draftId} {
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // ── Users (profil + abonnement) ─────────────────────────────────────────
    match /users/{userId} {
      // Resserré (28.08.26) : avant, tout utilisateur connecté pouvait lire
      // N'IMPORTE QUEL document users/{userId} (email, fcmTokens…). La
      // justification d'origine — « retrouver un compte par email lors du
      // partage » — décrivait un chemin mort (UserService.findUidByEmail
      // n'était appelé nulle part ; le partage réel se fait par lien/token,
      // voir backend/api/tag/[action].ts::join). Le seul vrai besoin restant
      // — afficher les collaborateurs d'un tag partagé — est maintenant
      // résolu côté backend (Admin SDK, action `collaborators` du même
      // fichier), qui ré-autorise tag par tag avant de révéler quoi que ce
      // soit. Chacun ne lit donc plus que son propre document.
      allow read: if isAuth() && request.auth.uid == userId;

      // subscriptionTier ne peut être écrit que par le backend (Admin SDK)
      // ou l'admin — jamais par l'utilisateur lui-même.
      allow create: if isAuth() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['subscriptionTier']);
      allow update: if isAdmin() || (
        isAuth() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['subscriptionTier'])
      );
      allow delete: if isAdmin();
    }

    // ── Orders ──────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      // Une commande naît TOUJOURS « reçue », jamais payée (01.10.26).
      // Avant, la règle ne vérifiait que `userId` : le client écrivant son
      // document lui-même (OrderService.createOrder), rien ne l'empêchait de
      // poser `status: 'paid'` et `price: 0`. La console admin l'affichait
      // alors comme payée, le rappel quotidien poussait à l'envoyer à
      // l'impression, et `prodigi/order` — qui ne contrôle que ce même
      // `status` — fabriquait et expédiait le livre aux frais de la maison.
      // Les champs ci-dessous ne sont écrits QUE par le backend (Admin SDK)
      // ou l'admin : les interdire à la création ferme la porte pour de bon.
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('status', '') == 'received'
        && !request.resource.data.keys().hasAny([
             'paidAt', 'stripeSessionId', 'archivedAt', 'archivedBy',
             'prodigiOrderId', 'prodigiStatus', 'prodigiStage',
             'prodigiStageDetails', 'prodigiShipments', 'prodigiError',
             'prodigiRetryCount', 'trackingNumber', 'trackingUrl',
             'carrierName', 'shippedAt', 'shippedFromCountry',
             'shippedNotifiedAt', 'accountDeleted'
           ]);
      allow read: if isAuth()
        && (resource.data.userId == request.auth.uid || isAdmin());
      // Statut et notes gérés par l'admin uniquement
      allow update, delete: if isAdmin();
    }

    // ── Activités (fil "Karin a ajouté 3 photos à…") ─────────────────────────
    // Créée par n'importe quel destinataire au nom de son propre geste
    // (`actorUid == auth.uid`), lisible/modifiable seulement par les
    // destinataires (`recipients`, figé au moment de l'action — ne suit pas
    // les partages ultérieurs). `update` restreint à `seenBy` uniquement :
    // un destinataire ne peut que s'ajouter lui-même à l'accusé de lecture,
    // jamais modifier le contenu de l'activité.
    match /memoryActivities/{activityId} {
      allow create: if isAuth()
        && request.resource.data.get('actorUid', '') == request.auth.uid
        && request.auth.uid in request.resource.data.get('recipients', []);
      allow read: if isAuth()
        && request.auth.uid in resource.data.get('recipients', []);
      allow update: if isAuth()
        && request.auth.uid in resource.data.get('recipients', [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])
        && request.auth.uid in request.resource.data.get('seenBy', []);
      allow delete: if false;
    }

    // ── Reels (vidéos consolidées derrière un QR imprimé) ───────────────────
    // Deux usages : le QR d'un poster (`poster-reel-create`) et celui de la
    // COUVERTURE d'un livre (`book-reel-create`, `videosOnly: true`).
    // Créés par le backend (Admin SDK), donc ces règles ne s'appliquent qu'à
    // un éventuel accès direct côté client — il n'y en a aucun aujourd'hui :
    // la page publique `poster-video-reel` lit ce doc côté serveur, jamais
    // depuis l'app. Lecture/mise à jour fermées côté client par prudence.
    match /posterReels/{reelId} {
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Liens de partage temporaires d'un souvenir (`share-create`, page
    // publique `share`) — même principe que `posterReels` : écrits et lus
    // exclusivement par le backend (Admin SDK), jamais par l'app cliente.
    // Fermé côté client par prudence.
    match /shares/{token} {
      allow read, write: if false;
    }

    // ── Legacy : children ───────────────────────────────────────────────────
    match /children/{childId} {
      allow create: if isAuth()
        && request.resource.data.parentId == request.auth.uid;
      allow read, update, delete: if isAuth()
        && resource.data.parentId == request.auth.uid;
    }

    // ── Legacy : milestones (liées par childId) ─────────────────────────────
    match /milestones/{milestoneId} {
      allow create: if isAuth() && ownsChild(request.resource.data.childId);
      allow read, update, delete: if isAuth() && ownsChild(resource.data.childId);
    }

    // aiUsage/{uid} : géré exclusivement par le backend (Admin SDK).
    // Aucune règle = accès client refusé par défaut.
  }
}
