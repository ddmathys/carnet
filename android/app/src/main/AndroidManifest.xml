<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <!-- Android 13+ : afficher une notification demande l'accord explicite de
         l'utilisateur, réclamé depuis le profil ou à la création du compte. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Folio"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link d'invitation : carnet://join?token=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="carnet" android:host="join"/>
            </intent-filter>

            <!-- Partage entrant, UN média : depuis Google Photos ou la galerie,
                 « Partager » propose Carnet, qui ouvre le formulaire de souvenir
                 avec la photo ou la vidéo déjà attachée.
                 Le `label` est ce qui s'affiche dans le menu de partage
                 d'Android (sans lui, ce serait le nom de l'appli, « Folio »). -->
            <intent-filter android:label="Carnet">
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="video/*"/>
            </intent-filter>

            <!-- Partage entrant, PLUSIEURS médias en une fois. Une sélection
                 mixte (photos + vidéos) est souvent envoyée avec le type
                 générique */* : sans cette ligne, Carnet n'apparaîtrait pas dans
                 le menu de partage de ces sélections-là. Ce qui n'est ni image
                 ni vidéo est écarté à la réception (MainActivity.copyToCache). -->
            <intent-filter android:label="Carnet">
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="video/*"/>
                <data android:mimeType="*/*"/>
            </intent-filter>

            <!-- Raccourcis de partage : rend Carnet éligible à la rangée de
                 suggestions, tout en haut du menu de partage. Un raccourci par
                 tag, publié à chaud une fois l'utilisateur connu. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Canal par défaut des push reçus quand l'appli est fermée. Il doit
             porter le même id que le canal créé dans MainActivity, sinon
             Android range les notifications dans un canal « Divers » sans nom. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="souvenirs" />
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
